rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return hasProfile() && profile().role == 'owner';
    }

    // An assistant is a trusted reviewer: they see and approve everyone's
    // work and can clear the signup queue, but they cannot change anyone's
    // role, remove people, edit pricing, or delete a quote.
    function isAssistant() {
      return hasProfile() && profile().role == 'assistant' && profile().active == true;
    }

    function isManager() {
      return isOwner() || isAssistant();
    }

    // A signed-up account is inert until the owner approves it. Until then
    // it can see nothing and write nothing except its own pending profile.
    function isApproved() {
      return hasProfile() && profile().active == true;
    }

    // The one address allowed to hold the 'owner' role. Must match
    // ownerEmail in config.js. Change both together.
    function ownerEmail() {
      return 'info@jtproconstruction.com';
    }

    function claimedEmail() {
      return request.auth.token.email.lower();
    }

    // ---- USER PROFILES ----
    match /users/{uid} {
      // You can always read your own profile (that is how the app learns
      // whether you have been approved yet). Seeing the rest of the team
      // requires approval.
      allow read: if isApproved() || (signedIn() && request.auth.uid == uid);

      // A person can create only their own profile, and only as an
      // associate. Without this, anyone who signs up could hand
      // themselves role:'owner' and read every quote in the company.
      // The owner role is granted solely to the address above, proven
      // by the verified email on the auth token — not by anything the
      // browser sends.
      // New associates are created INACTIVE and stay locked out until the
      // owner approves them. Only the owner's own address may self-create
      // an active profile, otherwise nobody could ever approve anyone.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email.lower() == claimedEmail()
        && (
             (request.resource.data.role == 'associate' && request.resource.data.active == false)
             || (request.resource.data.role == 'owner'
                 && request.resource.data.active == true
                 && claimedEmail() == ownerEmail())
           );

      // The owner can change anything except their own role.
      // An assistant may only flip the approval switch on an associate:
      // never a role, never the owner, never another assistant.
      allow update: if
        (
          isOwner()
          && (request.resource.data.role == resource.data.role
              || request.auth.uid != uid)
        )
        || (
          isAssistant()
          && resource.data.role == 'associate'
          && request.resource.data.role == 'associate'
          && request.resource.data.id == resource.data.id
          && request.resource.data.email == resource.data.email
          && request.auth.uid != uid
        );

      // Removing people is the owner's alone. Quotes are unaffected —
      // this only clears out profiles, never work.
      allow delete: if isOwner() && request.auth.uid != uid;
    }

    // ---- QUOTES ----
    match /quotes/{quoteId} {
      // Owner and assistants see everything. Approved associates see only
      // their own. An unapproved account sees nothing at all.
      allow read: if isManager() ||
        (isApproved() && resource.data.createdBy == request.auth.uid);

      // Managers can create a quote in any state (they can approve their own
      // work on the spot). Approved associates create unapproved work only.
      allow create: if isManager() ||
        (isApproved() &&
         request.resource.data.createdBy == request.auth.uid &&
         request.resource.data.status in ['draft', 'pending']);

      // Associates can edit their own work only while it is unapproved, and
      // cannot promote it past 'pending'. Once it is approved or voided,
      // they are out.
      allow update: if isManager() ||
        (isApproved() &&
         resource.data.createdBy == request.auth.uid &&
         request.resource.data.createdBy == request.auth.uid &&
         resource.data.status in ['draft', 'pending', 'changes'] &&
         request.resource.data.status in ['draft', 'pending', 'changes']);

      // Voiding is reversible and leaves the record intact, so assistants
      // can do it. Erasing a quote outright is the owner's call alone.
      allow delete: if isOwner();
    }

    // ---- COMPANY SETTINGS ----
    match /settings/company {
      // Labor rates and margins are internal. Approved team only —
      // a pending account must not learn your cost basis.
      allow read: if isApproved();
      allow write: if isOwner();
    }

    // The sign-up screen has to check the team code before anyone is signed
    // in, so the code lives in its own document. It contains no pricing data.
    // Managers write it because the code rotates when the queue is cleared.
    match /settings/joincode {
      allow read: if true;
      allow write: if isManager();
    }

    // ---- ACTIVITY LOG ----
    match /activity/{entryId} {
      // Owner and assistants can read the log.
      allow read: if isManager();
      // Approved members add to it; nobody can alter history.
      allow create: if isApproved();
      allow update, delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
