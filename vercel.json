{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no install needed - static site'",
  "buildCommand": "echo 'no build needed - index.html is committed'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/site/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(), camera=(self)"
        }
      ]
    }
  ],
  "functions": {
    "api/ai-quote.js": {
      "maxDuration": 120
    },
    "api/ingest-lead.js": {
      "maxDuration": 120
    },
    "api/read-lead.js": {
      "maxDuration": 60
    },
    "api/notify.js": {
      "maxDuration": 30
    },
    "api/img.js": {
      "maxDuration": 20
    },
    "api/ai-job.js": {
      "maxDuration": 20
    },
    "api/property.js": {
      "maxDuration": 30
    },
    "api/materials.js": {
      "maxDuration": 90
    },
    "api/billing.js": {
      "maxDuration": 30
    },
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/contact.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.s-i-quotespro.com"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "start"
        },
        {
          "type": "query",
          "key": "login"
        },
        {
          "type": "query",
          "key": "quote"
        },
        {
          "type": "query",
          "key": "billing"
        },
        {
          "type": "query",
          "key": "admin"
        },
        {
          "type": "query",
          "key": "session_id"
        },
        {
          "type": "query",
          "key": "app"
        }
      ],
      "destination": "/site/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "s-i-quotespro.com"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "start"
        },
        {
          "type": "query",
          "key": "login"
        },
        {
          "type": "query",
          "key": "quote"
        },
        {
          "type": "query",
          "key": "billing"
        },
        {
          "type": "query",
          "key": "admin"
        },
        {
          "type": "query",
          "key": "session_id"
        },
        {
          "type": "query",
          "key": "app"
        }
      ],
      "destination": "/site/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/help",
      "destination": "/#help",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "www.s-i-quotespro.com"
        }
      ]
    },
    {
      "source": "/help",
      "destination": "/#help",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "s-i-quotespro.com"
        }
      ]
    },
    {
      "source": "/support",
      "destination": "/#help",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "www.s-i-quotespro.com"
        }
      ]
    },
    {
      "source": "/support",
      "destination": "/#help",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "s-i-quotespro.com"
        }
      ]
    }
  ]
}
