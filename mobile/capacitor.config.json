{
  "appId": "com.siquotespro.app",
  "appName": "S-I-Quotespro",
  "webDir": "www",
  "server": {
    "hostname": "localhost",
    "androidScheme": "https",
    "cleartext": false
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0B1F3A"
  },
  "android": {
    "backgroundColor": "#0B1F3A",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0B1F3A",
      "launchAutoHide": true,
      "androidSplashResourceName": "siq_icon",
      "androidScaleType": "CENTER_INSIDE"
    }
  }
}
